{
  "name": "@bole/sdk-server",
  "version": "0.1.0",
  "description": "Bole SDK JSON-RPC bridge over a DeepSeek Harness runtime",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.1.7-alpha.2"
  }
}
