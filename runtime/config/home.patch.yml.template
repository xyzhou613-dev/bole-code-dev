# Copy to <DSH_HOME>/cordis.patch.yml. This is the writable site layer for
# MCP servers; the model gateway lives in runtime/cordis.patch.yml because the
# C launcher passes that file as the highest-priority --patch layer. Set it
# with install.ps1 -ModelGateway (or edit runtime/cordis.patch.yml).
# Restart the runtime after edits.

# One row per MCP server. SDK v1 reads this file at startup; restart after edits.
- insert:
    - id: mcp-toy
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        transport: stdio
        serverName: toy
        command: '<runtime-dir>/node.exe'
        args: ['<package-root>/tools/toy-mcp/server.mjs']
        cwd: '<package-root>'
        toolCallTimeoutMs: 10000
        failOnStartupError: false
